{
  "mcpServers": {
    "kanzo": {
      "command": "kanzo",
      "args": [
        "mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.13.0",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--executablePath",
        "/usr/bin/chromium",
        "--screenshotFormat",
        "jpeg",
        "--screenshotMaxWidth",
        "1280"
      ]
    }
  }
}