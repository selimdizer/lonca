    "Bash(git clean *)",
    "Bash(git branch -D *)",
    "Bash(git -C * reset --hard*)",
    "Bash(git -C * push *--force*)",
    "Bash(pkill *)",
    "Bash(killall *)",
    "Bash(gh pr merge*)",
    "Bash(gh api *merge*)",
    "Bash(git push * main*)",
    "Bash(git push * master*)",
    "Bash(git push *:main*)",
    "Bash(git push *:master*)",
    "Bash(git push *--no-verify*)",
    "Bash(git push --no-verify*)",
    "Bash(*ALLOW_MAIN_PUSH*)",
    "Bash(git config *hooksPath *)",
    "Bash(git config *--unset*hooksPath*)",
    "Bash(*/gh pr merge*)",
    "Bash(*gh pr merge*)",
    "Bash(ok-merge*)",
    "Bash(*/ok-merge *)",
    "Bash(night-on*)",
    "Bash(*/night-on *)"
  ]
