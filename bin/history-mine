#!/usr/bin/env python3
"""history-mine [--days N]: the owner's own decision-worded messages from Claude sessions of the last N days (default 31).

Writes ~/.cache/ai-runs/setup/history-mining/owner-messages-<date>.md for the monthly memory check: a Sonnet
subagent turns it into candidates with ~/lonca/config/history-candidates.prompt.md; the owner approves each one.
Only the owner's typed text: no tool output, system reminders or pasted blocks; one copy of each message.
"""
import glob, hashlib, json, os, re, sys, time

days = int(sys.argv[sys.argv.index("--days") + 1]) if "--days" in sys.argv else 31
since = time.time() - days * 86400
out = os.path.expanduser(f"~/.cache/ai-runs/setup/history-mining/owner-messages-{time.strftime('%Y-%m-%d')}.md")
kw = re.compile(r"\b(never|always|from now on|don't|must|rule|decide|prefer|asla|hiç ?bir zaman|her zaman|bundan sonra|artık|karar|kural|yapma|yapmayın|olmasın|olmamalı|"
                r"istemiyorum|unutma|sakın|önemli|şart|zorunlu|yasak|izin ver|onaylıyorum|kesinlikle|tercih)\w*", re.I)
seen, rows = set(), []
for f in glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl")):
    if os.path.getmtime(f) < since:
        continue
    proj = os.path.basename(os.path.dirname(f)).replace("-" + os.path.expanduser("~").strip("/").replace("/", "-") + "-", "")
    for line in open(f, errors="ignore"):
        try:
            m = json.loads(line)
        except ValueError:
            continue
        if m.get("type") != "user" or m.get("isSidechain") or m.get("isMeta"):
            continue
        ts = m.get("timestamp", "")
        try:
            if time.mktime(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")) < since:
                continue
        except ValueError:
            pass
        c = (m.get("message") or {}).get("content")
        texts = [c] if isinstance(c, str) else [b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text"] if isinstance(c, list) else []
        for t in (t.strip() for t in texts):
            if not (15 <= len(t) <= 1500) or t.startswith("<") or "system-reminder" in t or not kw.search(t):
                continue
            h = hashlib.sha1(t.lower().encode()).hexdigest()
            if h not in seen:
                seen.add(h)
                rows.append((ts, proj, m.get("sessionId", ""), t))
rows.sort()
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, "w") as o:
    o.write(f"# Owner messages with decision wording, last {days} days ({len(rows)})\n\n")
    for ts, proj, sid, t in rows:
        o.write(f"## {ts[:16]} | {proj} | {sid[:8]}\n{t}\n\n")
print(f"{len(rows)} messages -> {out}")
