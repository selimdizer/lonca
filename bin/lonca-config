#!/usr/bin/env python3
"""lonca-config <key> [default]: one value from ~/.config/lonca/config.toml (XDG_CONFIG_HOME respected), printed for
shell use: a list prints one item per line, true/false print as such. Missing file or key: the default (or nothing).

Keys (all optional):
  tmpdir            = "~/.cache/lonca/tmp"      agents' TMPDIR in lanes (Claude sessions too if you chose it at install)
  cleanup_tmp_dirs  = ["/tmp", "/var/tmp"]      extra temp folders ai-cleanup may clear (default: only tmpdir)
  auto_merge        = "off"                     default for projects whose .lonca.toml doesn't say: off|low|medium|all
"""
import ast, os, re, sys

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    print(__doc__.strip()); sys.exit(0)
path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "lonca", "config.toml")
val = None
try:
    try:
        import tomllib
        with open(path, "rb") as f:
            val = tomllib.load(f).get(sys.argv[1])
    except ImportError:  # Python < 3.11: simple `key = value` lines (strings, lists of strings, true/false)
        for line in open(path):
            m = re.match(r"\s*" + re.escape(sys.argv[1]) + r"\s*=\s*(.+?)\s*(#.*)?$", line)
            if m:
                v = m.group(1).replace("true", "True").replace("false", "False")
                val = ast.literal_eval(v)
except OSError:
    pass
if val is None:
    val = sys.argv[2] if len(sys.argv) > 2 else None
if val is None:
    sys.exit(0)
for v in (val if isinstance(val, list) else [val]):
    print(str(v).lower() if isinstance(v, bool) else os.path.expanduser(str(v)))
