#!/usr/bin/env python3
"""lonca-project [dir]: which project a directory belongs to. Prints "<name>\t<root>"; nothing (exit 1) outside any project.

Like mise/EditorConfig/direnv: a lane worktree counts as its main repo; from there walk up to / and the closest
`.lonca.toml` (or `lonca.toml`) marks the project root, so one marker in a parent folder groups several repos.
Its `name = "..."` names the project (memory group, Kanzo slug); default: the folder's name in lower case.
No marker: exit 1. LONCA_PROJECT overrides the name.
"""
import json, os, re, subprocess, sys

def marker_name(path):
    try:
        import tomllib  # Python 3.11+
        with open(path, "rb") as f:
            return tomllib.load(f).get("name")
    except ImportError:  # older Python (macOS ships 3.9): the one key Lonca reads
        m = re.search(r'^\s*name\s*=\s*["\']([^"\']+)["\']', open(path).read(), re.M)
        return m.group(1) if m else None

args = sys.argv[1:]
role = None
if args[:1] == ["--claude-agent"] and len(args) >= 2:
    role, args = args[1], args[2:]
start = os.path.realpath(args[0] if args else os.getcwd())
r = subprocess.run(["git", "-C", start, "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True)
repo = os.path.dirname(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip().endswith("/.git") else None

if not os.path.isdir(start):
    sys.exit(1)
d = repo or start
while True:
    for n in (".lonca.toml", "lonca.toml"):
        if os.path.isfile(os.path.join(d, n)):
            name = os.environ.get("LONCA_PROJECT") or marker_name(os.path.join(d, n)) or os.path.basename(d).lower()
            if not isinstance(name, str) or not name or name in (".", "..") or os.path.basename(name) != name or not name.isprintable():
                sys.exit("invalid Lonca project name")
            if role:
                local = os.path.join(repo or start, ".claude/settings.local.json")
                try:
                    with open(local) as f:
                        enabled = json.load(f).get("enabledPlugins", {}).get("lonca@lonca")
                except FileNotFoundError:
                    enabled = False
                print(("lonca:" if enabled else "") + role)
                sys.exit(0)
            print(f"{name}\t{d}")
            sys.exit(0)
    if d == "/":
        break
    d = os.path.dirname(d)
sys.exit(1)
