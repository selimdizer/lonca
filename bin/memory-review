#!/usr/bin/env python3
"""memory-review [--since-hours N] [--dry-run]: background memory review (timer, every 2 h).

Collects the owner's messages from all Claude sessions since the last review (state file), each with a short
excerpt of the agent turn it answered, and lets Sonnet save durable decisions into ~/ai-memory following
~/lonca/config/memory-review.prompt.md. No new messages -> no model call. Log: ~/.cache/ai-runs/setup/memory-review.log
"""
from functools import lru_cache
from pathlib import Path
from lonca_registry import registered
import calendar, glob, json, os, re, subprocess, sys, time

HOME = os.path.expanduser("~")
STATE = f"{HOME}/.local/state/lonca/memory-review.last"
LOG = f"{HOME}/.cache/ai-runs/setup/memory-review.log"
PROMPT = f"{HOME}/lonca/config/memory-review.prompt.md"
DRY = "--dry-run" in sys.argv
for k in [k for k in os.environ if k == "CLAUDECODE" or k.startswith(("CLAUDE_", "CODEX_COMPANION_"))]:
    del os.environ[k]                      # a separate session, never a child of whoever ran this

now = time.time()
if "--since-hours" in sys.argv:
    since = now - float(sys.argv[sys.argv.index("--since-hours") + 1]) * 3600
else:
    try:
        since = float(open(STATE).read().strip())
    except (OSError, ValueError):
        since = now - 2 * 3600

def ts_of(m):
    try:
        return calendar.timegm(time.strptime(m.get("timestamp", "")[:19], "%Y-%m-%dT%H:%M:%S"))  # stored in UTC
    except ValueError:
        return 0

def text_of(c):
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return "\n".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
    return ""

projects = registered()
if not projects:
    sys.exit(0)
# Claude encodes cwd in the directory name. Check each message's actual cwd as well,
# since punctuation in the encoded directory name can collide across projects.
prefixes = {re.sub(r"[^a-zA-Z0-9]", "-", str(root)) for root in projects}
@lru_cache(maxsize=1024)
def included(cwd):
    if not any(cwd == root or root in cwd.parents for root in projects):
        return False
    for ancestor in (cwd, *cwd.parents):
        if any((ancestor / name).is_file() for name in (".lonca.toml", "lonca.toml")):
            return ancestor in projects
    return False


items = []
session_base = Path(HOME) / ".claude/projects"
folders = {folder for prefix in prefixes for folder in
           [session_base / prefix, *session_base.glob(glob.escape(prefix) + "-*")] if folder.is_dir()}
for f in (file for folder in folders for file in folder.glob("*.jsonl") if file.resolve() == file):
    if os.path.getmtime(f) < since:
        continue
    proj = os.path.basename(os.path.dirname(f)).replace("-" + os.path.expanduser("~").strip("/").replace("/", "-") + "-", "")
    if "ai-memory" in proj or "herdr-worktrees" in proj:   # the reviewer's own sessions; lanes (their prompts come from the lead)
        continue
    last_agent = ""
    for line in open(f, errors="ignore"):
        try:
            m = json.loads(line)
        except ValueError:
            continue
        cwd = Path(m.get("cwd") or "/").resolve()
        if not included(cwd):
            last_agent = ""
            continue
        if m.get("isSidechain") or m.get("entrypoint") == "sdk-cli":   # subagents; headless claude -p runs
            continue
        t = text_of((m.get("message") or {}).get("content"))
        t = re.sub(r"<hc from=.*?</hc>|<pasted_content[^>]*>.*?</pasted_content[^>]*>", "", t, flags=re.S).strip()  # lane messages, pasted text: not the owner
        if m.get("type") == "assistant" and t:
            last_agent = t
        elif m.get("type") == "user" and not m.get("isMeta") and t and not t.startswith("<") \
                and "system-reminder" not in t and not t.startswith(("STALLED:", "QUESTION:", "DONE:")) and 2 <= len(t) <= 2000 and ts_of(m) > since:
            items.append((m.get("timestamp", "")[:16], proj, m.get("sessionId", "")[:8], last_agent[-600:], t))
items.sort()
os.makedirs(os.path.dirname(LOG), exist_ok=True)
if not items:
    if not DRY:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        open(STATE, "w").write(str(now))
    sys.exit(0)

inp = f"{HOME}/.cache/ai-runs/setup/history-mining/review-{time.strftime('%Y%m%d-%H%M')}.md"
os.makedirs(os.path.dirname(inp), exist_ok=True)
with open(inp, "w") as o:
    for ts, proj, sid, agent, t in items:
        o.write(f"## {ts} | {proj} | {sid}\nAGENT (excerpt): {agent}\nOWNER: {t}\n\n")
print(f"{len(items)} owner messages -> {inp}")
if DRY:
    sys.exit(0)

prompt = open(PROMPT).read() + f"\n\nInput file: {inp}\n"
r = subprocess.run(["claude", "-p", "--model", "sonnet", "--permission-mode", "acceptEdits",
                    "--allowedTools", "Read,Grep,Glob,Write,Edit,Bash(ls:*),Bash(grep:*)"],
                   input=prompt, capture_output=True, text=True, cwd=f"{HOME}/ai-memory", timeout=1800)
with open(LOG, "a") as lg:
    lg.write(f"# {time.strftime('%Y-%m-%d %H:%M')} {len(items)} messages, exit {r.returncode}\n{r.stdout.strip()[-3000:]}\n")
if r.returncode == 0:
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    open(STATE, "w").write(str(now))
print(r.stdout.strip()[-1500:])
sys.exit(r.returncode)
