#!/bin/sh
# Create this month's maintenance card on the Kanzo board (project from the checklist file, default "maintenance"), marked human: the owner starts it.
set -eu
m=$(date +%Y-%m)
cd "$HOME/lonca"
# the checklist: ~/lonca-local/config/monthly-card.md if you keep your own, else Lonca's default
list=$HOME/lonca-local/config/monthly-card.md; [ -f "$list" ] || list=$HOME/lonca/config/monthly-card.md
title=$(sed -n '1s/^# //p' "$list")   # first line "# <title>"
proj=$(sed -n 's/^project: *//p' "$list" | head -1); proj=${proj:-maintenance}
"$HOME/lonca/bin/project-job" registered "$proj" || exit 0
claude -p --model haiku --permission-mode bypassPermissions "Use the kanzo MCP tools only. In the kanzo project named '$proj' (create it if it does not exist, without linking a repo), create a task titled '$title $m' unless a task with that title already exists. Description, as a checklist:
$(sed -e 1d -e "/^project:/d" "$list")
Mark the task as human. Reply with the task id only." < /dev/null
