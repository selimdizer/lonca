#!/bin/sh
# The only way an agent may merge.
#   merge-pr    [--dry-run] <repo-dir> <pr-number> <run-dir> <lane>   needs the owner's grant: ok-merge <owner/repo>#<pr>
#   night-merge [--dry-run] <repo-dir> <pr-number> <run-dir> <lane>   needs tonight's night file: night-on …
# Both refuse unless the PR is open, not a draft and mergeable; every CI check is green (with an `ok-merge --fast`
# grant, checks still running are fine but a failed one is not; a repo without CI needs --fast); the lane's evidence
# files in <run-dir> say PASS / SHIP / PERF OK / no HIGH security finding for the PR's current head commit; and the
# PR title/body carry no AI attribution. Night mode also checks the end time, the merge count and the repo/base list.
# The merge method follows the repo: merge commit if allowed, else squash, else rebase (git config lonca.mergeMethod
# overrides). It merges exactly the checked head (--match-head-commit).
set -eu
for v in $(env | cut -d= -f1 | grep -E '^(CLAUDECODE|CLAUDE_[A-Z_]*|CODEX_COMPANION_[A-Z_]*)$'); do unset "$v"; done
dry=0; [ "${1:-}" = --dry-run ] && { dry=1; shift; }
me=$(basename "$0")
[ $# -eq 4 ] || { echo "usage: $me [--dry-run] <repo-dir> <pr-number> <run-dir> <lane>   (see the header of $0)" >&2; exit 2; }
repo=$(realpath "$1") pr=$2 run=$3 lane=$4
N=$HOME/.cache/ai-runs/night
no() { echo "$me: refused PR #$pr: $*" >&2; echo "$(date -Iseconds) refused $repo #$pr: $*" >> "$N/log" 2>/dev/null || true; exit 1; }
# the real gh, not the guard shim
GH=$(PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v "lonca/shims" | paste -sd: -) command -v gh)

day=0; [ "$(basename "$0")" = merge-pr ] && day=1
# one merge at a time on this machine: the night quota is counted and spent inside this lock
mkdir -p "$N"; i=0
until mkdir "$N/.merge.lock" 2>/dev/null; do
  i=$((i + 1)); [ $i -gt 300 ] && { echo "$me: another merge has held $N/.merge.lock for 5 min (remove it if stale)" >&2; exit 1; }
  sleep 1
done
trap 'rmdir "$N/.merge.lock" 2>/dev/null' EXIT INT TERM
if [ $day = 0 ]; then
  [ -e "$N/OFF" ] && no "night mode switched off ($N/OFF)"
  ls "$N"/*.json >/dev/null 2>&1 || no "no night mode tonight (no $N/<project>.json; only the owner starts it)"
fi
base=$(cd "$repo" && "$GH" pr view "$pr" --json baseRefName -q .baseRefName 2>/dev/null) || no "cannot read the PR"
# One night file per project (<kanzo-project>.json); the one that allows this repo+base decides, and counts its own merges
proj=day
[ $day = 1 ] || proj=$(python3 -I - "$N" "$repo" "$base" 2>/dev/null <<'EOF'
import json,sys,datetime,os,glob
N,repo,base=sys.argv[1:4]
for f in sorted(glob.glob(os.path.join(N,"*.json"))):
    n=json.load(open(f)); p=os.path.basename(f)[:-5]
    if not any(os.path.realpath(os.path.expanduser(a["repo"]))==repo and a["base"]==base for a in n["allow"]): continue
    assert datetime.datetime.now().astimezone() < datetime.datetime.fromisoformat(n["until"])
    log=os.path.join(N,"log")
    since=os.path.getmtime(f)   # count only merges since tonight's grant was written
    done=sum(1 for l in open(log) if f" merged [{p}] " in l and datetime.datetime.fromisoformat(l.split()[0]).timestamp()>=since) if os.path.exists(log) else 0
    assert done < int(n.get("max_merges",5))
    print(p); break
else: sys.exit(1)
EOF
) || no "repo/base not allowed tonight, past the end time, or max merges reached"

info=$(cd "$repo" && "$GH" pr view "$pr" --json state,isDraft,mergeable,title,body,statusCheckRollup,headRefOid 2>/dev/null) || no "cannot read the PR"
head=$(printf '%s' "$info" | python3 -I -c 'import json,sys;print(json.load(sys.stdin)["headRefOid"])')
nwo=$(cd "$repo" && "$GH" repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) || no "cannot read the repo name"
# day mode: the owner's own grant (ok-merge <owner/repo>#<pr>), at most 24 h old, used once
G=$HOME/.local/state/lonca/merge-grants/$(printf '%s' "$nwo" | tr '/' '_')_$pr
fast=0
if [ $day = 1 ]; then
  [ -f "$G" ] || no "no owner grant: the owner runs  ok-merge $nwo#$pr"
  [ $(( $(date +%s) - $(date -r "$G" +%s) )) -lt 86400 ] || no "owner grant older than 24 h; ask again"
  grep -q fast "$G" && fast=1   # ok-merge --fast: still-running CI does not block, a failed check still does
fi
err=$(printf '%s' "$info" | FAST=$fast python3 -I -c '
import json,os,sys; p=json.load(sys.stdin); fast=os.environ["FAST"]=="1"
assert p["state"]=="OPEN" and not p["isDraft"], "not open, or draft"
assert p["mergeable"]=="MERGEABLE", "not mergeable: "+p["mergeable"]
def running(c): return c.get("status") not in (None,"COMPLETED") or c.get("state") in ("PENDING","EXPECTED")
bad=[c.get("name") or c.get("context") for c in p["statusCheckRollup"]
     if (c.get("conclusion") or c.get("state")) not in ("SUCCESS","SKIPPED","NEUTRAL") and not (fast and running(c))]
assert fast or p["statusCheckRollup"], "no CI checks on the PR"
assert not bad, "checks not green: "+str(bad)
' 2>&1) || no "$(printf '%s' "$err" | tail -1)"

# Evidence: one file per checker (<lane>.verify.md, .review.md, .security.md), written by the lead from the
# checker's own result, each with a HEAD: <sha> line. The LAST verdict line in each file counts, and every
# file's HEAD must be the PR head now: a push after the checks voids them.
evd=$("$HOME/lonca/bin/merge-evidence" "$run" "$lane" "$head" 2>&1) || no "$(printf '%s' "$evd" | tail -1)"
printf '%s' "$info" | python3 -I -c 'import json,sys;p=json.load(sys.stdin);print(p["title"]);print(p["body"])' | "$HOME/lonca/bin/ai-trace-check" 2>/dev/null || no "PR title/body has AI traces"

[ $dry = 1 ] && { echo "$me: dry run OK for #$pr ($repo -> $base, $( [ $day = 1 ] && echo "day, owner said merge" || echo "night file $proj.json"))"; exit 0; }
method=$(git -C "$repo" config lonca.mergeMethod || true)
[ -n "$method" ] || method=$(cd "$repo" && "$GH" repo view --json mergeCommitAllowed,squashMergeAllowed,rebaseMergeAllowed \
  -q 'if .mergeCommitAllowed then "merge" elif .squashMergeAllowed then "squash" else "rebase" end' 2>/dev/null) || method=merge
(cd "$repo" && "$GH" pr merge "$pr" "--$method" --match-head-commit "$head") || no "gh merge ($method) failed"
[ $day = 1 ] && rm -f "$G"
echo "$(date -Iseconds) merged [$proj] $repo #$pr -> $base (lane $lane)" >> "$N/log"
"$HOME/lonca/bin/kanzo-sync" >/dev/null 2>&1 || true   # its card -> done now, not at the next timer run
echo "$me: merged #$pr into $base ($method)"
