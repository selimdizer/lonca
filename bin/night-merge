#!/bin/sh
# The only way an agent may merge.
#   merge-pr    [--dry-run] [--code <c>] <repo-dir> <pr-number> <run-dir> <lane>
#   night-merge [--dry-run] <repo-dir> <pr-number> <run-dir> <lane>       (night mode, started with night-on)
# Checks first, always: the PR is open, not a draft, mergeable; every CI check is green (an `ok-merge --fast` grant
# lets checks that are still running pass, never a failed one; a repo without CI needs --fast); the lane's evidence
# files fit the PR's risk tier (bin/merge-tier) for its current head commit (bin/merge-evidence); no AI attribution
# in the PR title/body. Then the approval (merge-pr):
#   - an owner grant (ok-merge <owner/repo>#<pr>), or
#   - auto-merge: the PR's tier is at or under the project's `auto_merge` level (lonca.toml: off|low|medium|all; else
#     `auto_merge` in ~/.config/lonca/config.toml; default off), at most `auto_merge_daily` a day (default 10;
#     0 or "unlimited" = no cap), or
#   - an approval code: without one, merge-pr prints a code bound to this head (valid 1 h) and exits 3; PRs asked
#     within 5 minutes share one code. The lead shows the owner the PRs, tiers and its opinion, the owner answers
#     "evet <code>" in chat once, and the lead reruns each with --code.
# Night mode instead checks tonight's file (end time, merge count, repo/base list). One merge at a time (a lock).
# The merge method follows the repo: merge commit if allowed, else squash, else rebase (git config lonca.mergeMethod
# overrides). It merges exactly the checked head (--match-head-commit). Log: ~/.cache/ai-runs/night/log.
set -eu
for v in $(env | cut -d= -f1 | grep -E '^(CLAUDECODE|CLAUDE_[A-Z_]*|CODEX_COMPANION_[A-Z_]*)$'); do unset "$v"; done
dry=0 code=
while [ $# -gt 0 ]; do case $1 in --dry-run) dry=1; shift ;; --code) code=${2:-}; shift 2 ;; *) break ;; esac; done
me=$(basename "$0")
[ $# -eq 4 ] || { echo "usage: $me [--dry-run] [--code <c>] <repo-dir> <pr-number> <run-dir> <lane>   (see the header of $0)" >&2; exit 2; }
repo=$(realpath "$1") pr=$2 run=$3 lane=$4
N=$HOME/.cache/ai-runs/night
A=$HOME/.local/state/lonca/approvals
no() { echo "$me: refused PR #$pr: $*" >&2; echo "$(date -Iseconds) refused $repo #$pr: $*" >> "$N/log" 2>/dev/null || true; exit 1; }
# the real gh, not the guard shim
GH=$(PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v "lonca/shims" | paste -sd: -) command -v gh)

day=0; [ "$(basename "$0")" = merge-pr ] && day=1
# one merge at a time on this machine: the night quota is counted and spent inside this lock
mkdir -p "$N"; i=0
until mkdir "$N/.merge.lock" 2>/dev/null; do
  i=$((i + 1)); [ $i -gt 300 ] && { echo "$me: another merge has held $N/.merge.lock for 5 min (remove it if stale)" >&2; exit 1; }
  sleep 1
done
trap 'rmdir "$N/.merge.lock" 2>/dev/null' EXIT INT TERM
if [ $day = 0 ]; then
  [ -e "$N/OFF" ] && no "night mode switched off ($N/OFF)"
  ls "$N"/*.json >/dev/null 2>&1 || no "no night mode tonight (no $N/<project>.json; only the owner starts it)"
fi
base=$(cd "$repo" && "$GH" pr view "$pr" --json baseRefName -q .baseRefName 2>/dev/null) || no "cannot read the PR"
# One night file per project (<kanzo-project>.json); the one that allows this repo+base decides, and counts its own merges
proj=day
[ $day = 1 ] || proj=$(python3 -I - "$N" "$repo" "$base" 2>/dev/null <<'EOF'
import json,sys,datetime,os,glob
N,repo,base=sys.argv[1:4]
for f in sorted(glob.glob(os.path.join(N,"*.json"))):
    n=json.load(open(f)); p=os.path.basename(f)[:-5]
    if not any(os.path.realpath(os.path.expanduser(a["repo"]))==repo and a["base"]==base for a in n["allow"]): continue
    assert datetime.datetime.now().astimezone() < datetime.datetime.fromisoformat(n["until"])
    log=os.path.join(N,"log")
    since=os.path.getmtime(f)   # count only merges since tonight's grant was written
    done=sum(1 for l in open(log) if f" merged [{p}] " in l and datetime.datetime.fromisoformat(l.split()[0]).timestamp()>=since) if os.path.exists(log) else 0
    mx=n.get("max_merges",5)
    assert mx in (0,"unlimited") or done < int(mx)
    print(p); break
else: sys.exit(1)
EOF
) || no "repo/base not allowed tonight, past the end time, or max merges reached"

info=$(cd "$repo" && "$GH" pr view "$pr" --json state,isDraft,mergeable,title,body,statusCheckRollup,headRefOid 2>/dev/null) || no "cannot read the PR"
head=$(printf '%s' "$info" | python3 -I -c 'import json,sys;print(json.load(sys.stdin)["headRefOid"])')
nwo=$(cd "$repo" && "$GH" repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) || no "cannot read the repo name"
# Risk tier (from the PR's diff; the lead may only raise it) and the project's settings
t=$("$HOME/lonca/bin/merge-tier" "$repo" "$pr" "$run" "$lane" 2>&1) || no "$t"
tier=${t%%	*} why=${t#*	}
cfg=$("$HOME/lonca/bin/merge-tier" --config "$repo" "$base" 2>/dev/null) || cfg='{}'
key=$(printf '%s' "$nwo" | tr '/' '_')_$pr
G=$HOME/.local/state/lonca/merge-grants/$key
how=night fast=0
if [ $day = 1 ]; then
  if [ -f "$G" ] && [ $(( $(date +%s) - $(date -r "$G" +%s) )) -lt 86400 ]; then
    how=grant; grep -q fast "$G" && fast=1   # ok-merge --fast: still-running CI does not block, a failed check still does
  elif [ -n "$code" ]; then
    [ -f "$A/$key" ] || no "no approval request for $nwo#$pr: run $me without --code first"
    set -- $(cat "$A/$key")   # <code> <head> <epoch>
    [ "$1" = "$code" ] || no "approval code '$code' does not match the one asked for $nwo#$pr"
    [ "$2" = "$head" ] || no "the PR changed since the owner approved it (head ${2%"${2#???????}"} -> ${head%"${head#???????}"}): ask again"
    [ $(( $(date +%s) - $3 )) -lt 3600 ] || no "approval code older than 1 h: ask again"
    how=code
  elif auto=$(printf '%s' "$cfg" | DEF="$("$HOME/lonca/bin/lonca-config" auto_merge off)" TIER="$tier" python3 -I -c '
import json, os, sys
c = json.load(sys.stdin); rank = {"off": -1, "low": 0, "medium": 1, "high": 2, "all": 2}
level = c.get("auto_merge") or ("low" if c.get("auto_merge_low") is True else os.environ["DEF"] or "off")
cap = c.get("auto_merge_daily", 10)
ok = rank.get(str(level), -1) >= rank[os.environ["TIER"]]
print(0 if str(cap) in ("0", "unlimited") else int(cap)); sys.exit(0 if ok else 1)'); then
    today=$(grep -c "^$(date +%Y-%m-%d).* merged \[auto\] " "$N/log" 2>/dev/null || true)
    [ "$auto" = 0 ] || [ "${today:-0}" -lt "$auto" ] || no "auto-merge cap reached today ($auto): ask the owner"
    how=auto proj=auto
  else
    how=ask
  fi
fi
err=$(printf '%s' "$info" | FAST=$fast python3 -I -c '
import json,os,sys; p=json.load(sys.stdin); fast=os.environ["FAST"]=="1"
assert p["state"]=="OPEN" and not p["isDraft"], "not open, or draft"
assert p["mergeable"]=="MERGEABLE", "not mergeable: "+p["mergeable"]
def running(c): return c.get("status") not in (None,"COMPLETED") or c.get("state") in ("PENDING","EXPECTED")
bad=[c.get("name") or c.get("context") for c in p["statusCheckRollup"]
     if (c.get("conclusion") or c.get("state")) not in ("SUCCESS","SKIPPED","NEUTRAL") and not (fast and running(c))]
assert fast or p["statusCheckRollup"], "no CI checks on the PR"
assert not bad, "checks not green: "+str(bad)
' 2>&1) || no "$(printf '%s' "$err" | tail -1)"

# Evidence: one file per checker (<lane>.verify.md, .review.md, .security.md), what the tier asks for, each verdict
# followed by the HEAD it judged (bin/merge-evidence). A push after the checks voids them.
evd=$("$HOME/lonca/bin/merge-evidence" "$run" "$lane" "$head" "$tier" 2>&1) || no "$(printf '%s' "$evd" | tail -1)"
printf '%s' "$info" | python3 -I -c 'import json,sys;p=json.load(sys.stdin);print(p["title"]);print(p["body"])' | "$HOME/lonca/bin/ai-trace-check" 2>/dev/null || no "PR title/body has AI traces"

short=${head%"${head#???????}"}
if [ $dry = 1 ]; then echo "$me: dry run OK for $nwo#$pr -> $base, tier $tier ($why), approval: $how"; exit 0; fi
if [ "$how" = ask ]; then
  mkdir -p "$A"
  # PRs asked within 5 minutes of each other share one code, so the owner answers a batch once
  if [ -f "$A/.batch" ] && [ $(( $(date +%s) - $(date -r "$A/.batch" +%s) )) -lt 300 ]; then c=$(cat "$A/.batch")
  else c=$(python3 -I -c 'import secrets; print("".join(secrets.choice("abcdefghjkmnpqrstuvwxyz23456789") for _ in range(3)))'); echo "$c" > "$A/.batch"; fi
  echo "$c $head $(date +%s)" > "$A/$key"
  echo "$me: checks passed; ask the owner. Show: $nwo#$pr -> $base, head $short, tier $tier ($why), your opinion$( [ "$tier" = high ] && echo ' and the risks')."
  echo "They approve by writing:  evet $c     then run:  $me --code $c $repo $pr $run $lane   (this head only, 1 h)"
  exit 3
fi
method=$(git -C "$repo" config lonca.mergeMethod || true)
[ -n "$method" ] || method=$(cd "$repo" && "$GH" repo view --json mergeCommitAllowed,squashMergeAllowed,rebaseMergeAllowed \
  -q 'if .mergeCommitAllowed then "merge" elif .squashMergeAllowed then "squash" else "rebase" end' 2>/dev/null) || method=merge
(cd "$repo" && "$GH" pr merge "$pr" "--$method" --match-head-commit "$head") || no "gh merge ($method) failed"
[ "$how" = grant ] && rm -f "$G"
[ "$how" = code ] && rm -f "$A/$key"
echo "$(date -Iseconds) merged [$proj] $repo #$pr -> $base (lane $lane, tier $tier, $how)" >> "$N/log"
"$HOME/lonca/bin/kanzo-sync" >/dev/null 2>&1 || true   # its card -> done now, not at the next timer run
echo "$me: merged $nwo#$pr into $base ($method, tier $tier, $how)"
