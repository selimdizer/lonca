#!/bin/sh
# ai-trace-check: refuse text (stdin) that carries AI attribution: co-author lines, "Generated with …", bot
# sign-offs. Used by the commit-msg hook, the gh guard shim, merge-pr and the Claude PreToolUse hook.
# Stricter, opt-in: `git config --global lonca.strictTraces true` also refuses any AI tool or model name
# (claude, codex, gpt-5 …). A repo about AI tools can lift that again with `git config lonca.toolNamesOk true`.
if [ "$(git config --bool lonca.strictTraces 2>/dev/null)" != true ] || [ "$(git config --bool lonca.toolNamesOk 2>/dev/null)" = true ]; then
  hit=$(grep -v '^#' | grep -o -i -E 'co-authored-by:.*(claude|anthropic|openai|codex|gpt|glm|copilot|gemini|deepseek|opencode|cursor)|generated (with|by) .{0,40}(claude|ai\b|codex|gpt|copilot|llm)|🤖|noreply@anthropic\.com|(written|implemented|reviewed|authored|created) by (an? )?(ai|agent|model|llm|bot)\b' | head -1)
else
hit=$(grep -v '^#' | grep -o -i -E \
 'co-authored-by:.*(claude|anthropic|openai|codex|gpt|glm|copilot|gemini|deepseek|opencode|cursor)|generated (with|by) .{0,40}(claude|ai\b|codex|gpt|copilot|llm)|🤖|claude[- ]?(code|session)|\bclaude\b|anthropic|noreply@anthropic\.com|\b(opus|sonnet|fable) ?[0-9]|\bgpt-?[0-9]|\bcodex\b|\bglm\b|opencode|oh-my-pi|(written|implemented|reviewed|authored|created) by (an? )?(ai|agent|model|llm|bot)\b' \
 | head -1)
fi
[ -z "$hit" ] && exit 0
echo "AI trace in the text: \"$hit\". PRs, issues, comments and commits here carry no AI attribution (see ~/lonca/bin/ai-trace-check); reword and try again." >&2
exit 1
