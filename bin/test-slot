#!/usr/bin/env python3
"""test-slot [-n N] -- <command>: run a heavy test command once one of N machine-wide slots is free.

Heavy suites (live/integration tests, -race, perf runs, full gates) from every lane and project share the slots, so
they wait instead of thrashing the machine. N: -n, else `test_slots` in ~/.config/lonca/config.toml, else 2.
Slots are lock files under ~/.local/state/lonca/test-slots (flock; a crashed holder frees its slot).
Prints once while it waits; the command's exit code is passed through. A test-slot inside a held slot (a verify
script that wraps itself) runs its command at once: the holder marks its command's environment (LONCA_TEST_SLOT).
"""
import fcntl, os, shlex, signal, subprocess, sys, time
from pathlib import Path

args = sys.argv[1:]
n = None
if args[:1] == ["-n"] and len(args) > 1:
    n, args = args[1], args[2:]
if args[:1] != ["--"] or len(args) < 2:
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(0 if sys.argv[1:2] in (["-h"], ["--help"]) else 2)
cmd = args[1:]
if os.environ.get("LONCA_TEST_SLOT"):
    os.execvp(cmd[0], cmd)   # already inside a slot: waiting for another would deadlock with N=1
if n is None:
    n = subprocess.run([Path(__file__).resolve().parent / "lonca-config", "test_slots", "2"],
                       capture_output=True, text=True).stdout.strip()
try:
    n = int(n)
    assert n >= 1
except (ValueError, AssertionError):
    sys.exit(f"test-slot: the slot count must be a whole number of at least 1, not {n!r}")

folder = Path.home() / ".local/state/lonca/test-slots"
folder.mkdir(parents=True, mode=0o700, exist_ok=True)


def slot(i):
    """The slot's lock file, never through a symlink (its holder line is truncated and written)."""
    try:
        return os.open(folder / f"slot-{i}", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError as e:
        sys.exit(f"test-slot: cannot open {folder / f'slot-{i}'}: {e.strerror} (symlinks are refused)")


holder = f"{os.environ.get('LONCA_LANE') or 'no lane'}: {shlex.join(cmd)}"
told = False
while True:
    for i in range(n):
        fd = slot(i)   # truncated only once the lock is ours: a waiter can read the holder line
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(fd)
            continue
        os.ftruncate(fd, 0); os.pwrite(fd, (holder + "\n").encode(), 0)
        # the lock stays with this process: a server the tests leave behind can't keep it
        p = subprocess.Popen(cmd, env=dict(os.environ, LONCA_TEST_SLOT=str(folder / f"slot-{i}")))
        signal.signal(signal.SIGINT, signal.SIG_IGN)   # Ctrl-C reaches the command itself; wait for its exit code
        for s in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(s, lambda sig, _: p.send_signal(sig))
        rc = p.wait()
        os.ftruncate(fd, 0)
        sys.exit(rc if rc >= 0 else 128 - rc)
    if not told:
        busy = []
        for i in range(n):
            fd = slot(i)
            busy.append(os.read(fd, 4096).decode(errors="replace").strip())
            os.close(fd)
        print("waiting for a test slot: " + "; ".join(b for b in busy if b), file=sys.stderr, flush=True)
        told = True
    time.sleep(2)
