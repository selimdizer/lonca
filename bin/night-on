#!/bin/sh
# Night mode for one project, started by the owner's word. While it is on, merge-pr merges every PR of the project
# that passes its checks (as if auto_merge were "all"), until the end time and, if one was set, up to a cap.
#   night-on --request <project> <until HH:MM> [<max-merges>]
#       the lead prepares tonight; prints a code (valid 1 h) for the owner to answer in chat ("başla <code>",
#       "start <code>": any language, the code is what binds)
#   night-on --code <code> <project>          the lead passes the owner's code: night mode starts
#   night-on --off <project>                  ends it early
# <project> is the name `lonca-project` prints for the project's repos.
set -eu
N=$HOME/.cache/ai-runs/night A=$HOME/.local/state/lonca/approvals
usage() { echo "usage: night-on --request <project> <HH:MM> [<max>]  |  night-on --code <code> <project>  |  night-on --off <project>" >&2; exit 2; }
case ${1:-} in
  --request)
    [ $# -eq 3 ] || [ $# -eq 4 ] || usage
    mkdir -p "$A"
    c=$(python3 -I -c 'import secrets; print("".join(secrets.choice("abcdefghjkmnpqrstuvwxyz23456789") for _ in range(3)))')
    python3 -I - "$A/night_$2.json" "$c" "$2" "$3" "${4:-unlimited}" <<'PY'
import datetime, json, sys, time
out, code, proj, until, mx = sys.argv[1:]
assert mx == "unlimited" or mx.isdigit(), "max merges: a number, or leave it out for no cap"
now = datetime.datetime.now().astimezone(); h, m = map(int, until.split(":"))
end = now.replace(hour=h, minute=m, second=0, microsecond=0)
if end <= now: end += datetime.timedelta(days=1)
night = {"until": end.isoformat(), "max_merges": mx if mx == "unlimited" else int(mx)}
json.dump({"code": code, "asked": time.time(), "night": night}, open(out, "w"))
print(f"night mode for {proj} prepared: until {end:%d.%m %H:%M}" + ("" if mx == "unlimited" else f", at most {mx} merges"))
print(f"The owner starts it by writing the code, e.g.:  başla {code}  (any language)     then run:  night-on --code {code} {proj}   (1 h)")
PY
    ;;
  --code)
    [ $# -eq 3 ] || usage
    f=$A/night_$3.json
    [ -f "$f" ] || { echo "night-on: nothing prepared for $3 (night-on --request first)" >&2; exit 1; }
    mkdir -p "$N"
    python3 -I - "$f" "$2" "$N/$3.json" <<'PY'
import json, os, sys, time
f, code, out = sys.argv[1:]
r = json.load(open(f))
if r["code"] != code: sys.exit(f"night-on: code '{code}' does not match the one asked")
if time.time() - r["asked"] > 3600: sys.exit("night-on: the code is older than 1 h; prepare again")
json.dump(r["night"], open(out, "w")); os.remove(f)
n = r["night"]
print(f"night mode on until {n['until'][11:16]}" + ("" if n["max_merges"] == "unlimited" else f", at most {n['max_merges']} merges"))
PY
    ;;
  --off)
    [ $# -eq 2 ] || usage
    rm -f "$N/$2.json" && echo "night mode off for $2" ;;
  *) usage ;;
esac
