#!/usr/bin/env python3
"""merge-evidence <run-dir> <lane> <pr-head-sha>: exit 0 when the lane's checks pass for exactly this head.

Files (written by the lead from each checker's own result):
  <lane>.verify.md    VERDICT: PASS|NEEDS_WORK   PERF: OK|REGRESSION|RISK   HEAD: <sha>
  <lane>.review.md    VERDICT: SHIP|NEEDS_WORK|MAJOR_RETHINK                 HEAD: <sha>
  <lane>.security.md  SECURITY: CLEAN | SECURITY: FINDINGS (n), highest: LOW|MEDIUM|HIGH   HEAD: <sha>
The last line of each kind counts (a re-check appends), and it counts only for the commit in the first HEAD: line
after it, which must be the PR head (at least 7 characters of it). So a PASS judged on commit A never passes for B,
even when a later check appends HEAD: B to the same file.
"""
import os, re, sys

run, lane, head = sys.argv[1:4]

def last(kind, pat):
    path = os.path.join(run, f"{lane}.{kind}.md")
    try:
        lines = [l.strip() for l in open(path).read().splitlines()]
    except OSError:
        sys.exit(f"missing {lane}.{kind}.md")
    idx = [i for i, l in enumerate(lines) if re.match(pat, l)]
    if not idx:
        sys.exit(f"no '{pat}' line in {lane}.{kind}.md")
    i = idx[-1]
    judged = next((l.split(":", 1)[1].strip() for l in lines[i + 1:] if l.startswith("HEAD:")), "")
    if len(judged) < 7 or not head.startswith(judged):
        sys.exit(f"{lane}.{kind}.md: '{lines[i]}' judged {judged[:12] or 'no HEAD'}, the PR head is {head[:12]}: re-check")
    return lines[i]

def need(ok, msg):
    if not ok:
        sys.exit(msg)

v = last("verify", r"VERDICT: ");  need(v.startswith("VERDICT: PASS"), f"verify: {v}")
p = last("verify", r"PERF: ");     need(p.startswith("PERF: OK"), f"perf: {p}")
r = last("review", r"VERDICT: ");  need(r.startswith("VERDICT: SHIP"), f"review: {r}")
s = last("security", r"SECURITY: ")
need(s.startswith("SECURITY: CLEAN") or (s.startswith("SECURITY: FINDINGS") and not re.search(r"highest:\s*HIGH", s, re.I)),
     f"security: {s}")
print("evidence OK for", head[:12])
