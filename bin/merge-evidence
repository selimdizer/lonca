#!/usr/bin/env python3
"""merge-evidence <run-dir> <lane> <pr-head-sha> [low|medium|high]: exit 0 when the lane's checks pass for exactly this
head, as the tier asks (default medium): verify PASS, review SHIP and a security result with no HIGH finding always
(for low the security result may come from the scanners alone); PERF: OK required for high, and for medium whenever a
PERF line exists (perf runs on hot paths); low ignores PERF.

Files (written by the lead from each checker's own result; each verdict is a whole line, exactly one of the values):
  <lane>.verify.md    a VERDICT: line (PASS or NEEDS_WORK), a PERF: line (OK, REGRESSION or RISK), each with HEAD: <sha>
  <lane>.review.md    a VERDICT: line (SHIP, NEEDS_WORK or MAJOR_RETHINK), then HEAD: <sha>
  <lane>.security.md  "SECURITY: CLEAN" or "SECURITY: FINDINGS (<n>), highest: <LOW, MEDIUM or HIGH>", then HEAD: <sha>
The last line of each kind counts (a re-check appends), and it counts only for the commit in the first HEAD: line
after it, which must be the PR head (at least 7 characters of it). So a PASS judged on commit A never passes for B,
even when a later check appends HEAD: B to the same file.
"""
import os, re, sys

run, lane, head = sys.argv[1:4]
tier = sys.argv[4] if len(sys.argv) > 4 else "medium"

def last(kind, pat):
    path = os.path.join(run, f"{lane}.{kind}.md")
    try:
        lines = [l.strip() for l in open(path).read().splitlines()]
    except OSError:
        sys.exit(f"missing {lane}.{kind}.md")
    idx = [i for i, l in enumerate(lines) if re.match(pat, l)]
    if not idx:
        sys.exit(f"no '{pat}' line in {lane}.{kind}.md")
    i = idx[-1]
    judged = next((l.split(":", 1)[1].strip() for l in lines[i + 1:] if l.startswith("HEAD:")), "")
    if len(judged) < 7 or not head.startswith(judged):
        sys.exit(f"{lane}.{kind}.md: '{lines[i]}' judged {judged[:12] or 'no HEAD'}, the PR head is {head[:12]}: re-check")
    return lines[i]

def need(ok, msg):
    if not ok:
        sys.exit(msg)

# whole lines only: a copied template line listing the alternatives is not a verdict
v = last("verify", r"VERDICT: ");  need(v == "VERDICT: PASS", f"verify: {v}")
has_perf = any(l.strip().startswith("PERF: ") for l in open(os.path.join(run, f"{lane}.verify.md")))
if tier == "high" or (tier == "medium" and has_perf):
    p = last("verify", r"PERF: ");  need(p == "PERF: OK", f"perf: {p}")
r = last("review", r"VERDICT: ");  need(r == "VERDICT: SHIP", f"review: {r}")
s = last("security", r"SECURITY: ")
need(s == "SECURITY: CLEAN" or re.fullmatch(r"SECURITY: FINDINGS \(\d+\), highest: (LOW|MEDIUM)", s),
     f"security: {s}")
print(f"evidence OK for {head[:12]} ({tier})")
