#!/usr/bin/env python3
"""Remove idle temporary directories, finished worktrees and old runs recorded by registered projects.
Use --dry-run to preview, or --tmp-age-hours N to change the default 48-hour temp age.
"""
import json, os, shutil, subprocess, sys, time
from pathlib import Path
from lonca_legacy import Legacy
from lonca_registry import registered, records, lane_worktree, resources, identity, names, forget_resource

DRY = "--dry-run" in sys.argv
AGE_H = int(sys.argv[sys.argv.index("--tmp-age-hours") + 1]) if "--tmp-age-hours" in sys.argv else 48
HOME, UID = Path.home(), os.getuid()
# never hand an agent session's variables to hc (it could start the core with them)
for k in [k for k in os.environ if k == "CLAUDECODE" or k.startswith(("CLAUDE_", "CODEX_COMPANION_", "IMPECCABLE_"))]:
    del os.environ[k]
LOG = HOME / ".cache/ai-runs/setup/cleanup.log"
now = time.time()
out = []

def say(msg):
    out.append(msg); print(msg)

def run(*a, cwd=None):
    return subprocess.run(a, cwd=cwd, capture_output=True, text=True)

def in_use_paths():
    """Paths open, used as cwd, or named by any process; None where /proc is missing (macOS): then nothing counts as free."""
    if not Path("/proc").is_dir():
        return None
    used = set()
    for p in Path("/proc").iterdir():
        if not p.name.isdigit():
            continue
        try:
            used.add(os.readlink(p / "cwd"))
            for fd in (p / "fd").iterdir():
                used.add(os.readlink(fd))
        except OSError:
            pass
        # a path only named in a process's env or args (a server's config dir) counts as in use too
        for f in ("environ", "cmdline"):
            try:
                for part in (p / f).read_bytes().decode(errors="ignore").replace("=", "\0").replace(":", "\0").split("\0"):
                    if part.startswith("/"):
                        used.add(part.rstrip("/"))
            except OSError:
                pass
    return used

Legacy(DRY).prune()
projects = registered()
if not projects:
    sys.exit(0)
UNREAD = object()
USED = UNREAD

def busy(path):
    global USED
    if USED is UNREAD:
        USED = in_use_paths()
    s = str(path)
    if USED is None:
        return True
    return any(u == s or u.startswith(s + "/") for u in USED)

def touched_within(path, hours):
    """Any change under path (the dir itself included) in the last `hours`: mtime OR ctime, since mv/tar/cp -a keep
    old mtimes but set a fresh ctime."""
    limit = now - hours * 3600
    for root, dirs, files in os.walk(path):
        for n in [""] + dirs + files:
            try:
                st = os.lstat(os.path.join(root, n) if n else root)
                if max(st.st_mtime, st.st_ctime) > limit:
                    return True
            except OSError:
                pass
    return False

def remove(path, why):
    if not DRY:
        try:
            shutil.rmtree(path)
        except OSError as error:
            say(f"could not remove {path}: {error}")
            return False
    say(f"{'would remove' if DRY else 'removed'} {path} ({why})")
    return True

# Paths and identities come from receipts written when the resources were created.
lanes = list(records(projects))
pr_cache = {}
runs = {}
for file, rec in lanes:
    repo, wt = Path(rec["repo"]), Path(rec["worktree"])
    folder = file.parent
    runs.setdefault(folder, []).append(rec)
    if not lane_worktree(rec):
        continue
    listing = run("git", "worktree", "list", "--porcelain", cwd=repo)
    entries = [block.splitlines() for block in listing.stdout.split("\n\n")]
    if not any(lines and lines[0] == f"worktree {wt}" and not any(x.startswith("locked") for x in lines)
               for lines in entries):
        continue
    status = run("git", "status", "--porcelain", cwd=wt)
    head = run("git", "rev-parse", "HEAD", cwd=wt)
    if status.returncode or status.stdout or head.returncode:
        continue
    if repo not in pr_cache:
        result = run("gh", "pr", "list", "--state", "all", "--limit", "3000",
                     "--json", "headRefName,headRefOid,number,state", cwd=repo)
        pr_cache[repo] = json.loads(result.stdout) if result.returncode == 0 else None
    if pr_cache[repo] is None:
        continue
    branch = rec["branch"]
    prs = [p for p in pr_cache[repo] if p["headRefName"] == branch]
    eligible = any(p["state"] in ("CLOSED", "MERGED") and (p["headRefOid"] == head.stdout.strip() or
                   p["state"] == "MERGED" and run("git", "merge-base", "--is-ancestor", head.stdout.strip(),
                                                  p["headRefOid"], cwd=repo).returncode == 0) for p in prs)
    if not prs:
        default = run("git", "symbolic-ref", "-q", "refs/remotes/origin/HEAD", cwd=repo)
        eligible = default.returncode == 0 and run("git", "merge-base", "--is-ancestor", head.stdout.strip(),
                                                   default.stdout.strip(), cwd=repo).returncode == 0
    if not eligible or any(p["state"] == "OPEN" for p in prs):
        continue
    if busy(wt) and prs:
        result = run("hc", "get", rec["name"], "--json")
        term = json.loads(result.stdout) if result.returncode == 0 else {}
        if term.get("cwd") == str(wt) and term.get("labels", {}).get("lonca.run") == rec["temp"]:
            say(f"close lane terminal {rec['name']} in {wt}")
            if not DRY:
                run("hc", "kill", term["address"])
                time.sleep(3)
                USED = in_use_paths()
    if not busy(wt) and lane_worktree(rec):
        say(f"remove finished worktree {wt} and branch {branch}")
        if not DRY and run("git", "worktree", "remove", str(wt), cwd=repo).returncode == 0:
            # Compare-and-delete: leave a branch advanced concurrently alone.
            run("git", "update-ref", "-d", "refs/heads/" + branch, head.stdout.strip(), cwd=repo)

for root in projects:
    for folder in resources(root, "temp"):
        if (folder.name.startswith(("lane-", "session-")) and folder.is_dir() and folder.stat().st_uid == UID
                and not busy(folder) and not touched_within(folder, AGE_H)):
            if remove(folder, f"recorded temp, unused for {AGE_H}h") and not DRY:
                forget_resource(root, "temp", folder)

base = HOME / ".cache/ai-runs"
slugs = {str(root): names([root]) for root in projects}
for folder, members in runs.items():
    if (any(folder.parent.name not in slugs[rec["project"]] for rec in members) or folder.parent.parent != base or folder.parent.name in ("setup", "night")
            or any(rec["run_id"] != identity(folder) or rec.get("base") != "-" and Path(rec["worktree"]).exists() for rec in members)
            or set(folder.glob("*.lane.json")) != {Path(rec["result"] + ".lane.json") for rec in members}):
        continue
    if not busy(folder) and not touched_within(folder, 30 * 24):
        if remove(folder, "recorded run unused for 30 days") and not DRY:
            for rec in members:
                forget_resource(rec["project"], "lane", rec["result"] + ".lane.json")
                forget_resource(rec["project"], "watch", rec["temp"])

if not DRY and out:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(f"# {time.strftime('%Y-%m-%d %H:%M')}\n" + "\n".join(out) + "\n")
