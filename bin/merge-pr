#!/bin/sh
# merge-pr [--dry-run] [--code <c>] <repo-dir> <pr-number> <run-dir> <lane>: the only way an agent merges a PR.
#
# Checks, always: the PR is open, not a draft, mergeable; CI is green (with `wait_for_ci = false` in the project's
#   .lonca.toml, checks still running don't block; a failed one always does); the lane's evidence files fit the PR's
#   risk tier (bin/merge-tier) for its current head commit (bin/merge-evidence); no AI attribution in the PR text.
# Approval, one of:
#   - auto: the tier is at or under the project's `auto_merge` (.lonca.toml: off | low | medium | all; default from
#     ~/.config/lonca/config.toml, else off);
#   - night mode: the project's night is on (night-on) and not past its end time: everything that passes the checks
#     merges, up to the night's cap if one was set;
#   - the owner's code: otherwise merge-pr prints a code bound to this head (valid 1 h) and exits 3. PRs asked within
#     5 minutes share one code. The lead shows the owner the PRs, tiers and its opinion; the owner answers
#     "evet <code>" once; the lead reruns each with --code.
# The merge method follows the repo (merge commit, else squash, else rebase; `git config lonca.mergeMethod` overrides)
# and merges exactly the checked head (--match-head-commit). One merge at a time (a lock). Log: ~/.local/state/lonca/merge.log
set -eu
for v in $(env | cut -d= -f1 | grep -E '^(CLAUDECODE|CLAUDE_[A-Z_]*|CODEX_COMPANION_[A-Z_]*)$'); do unset "$v"; done
dry=0 code=
while [ $# -gt 0 ]; do case $1 in --dry-run) dry=1; shift ;; --code) code=${2:-}; shift 2 ;; -h|--help) sed -n '2,/^set -eu/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;; *) break ;; esac; done
me=merge-pr
[ $# -eq 4 ] || { echo "usage: $me [--dry-run] [--code <c>] <repo-dir> <pr-number> <run-dir> <lane>   ($me --help)" >&2; exit 2; }
repo=$(realpath "$1") pr=$2 run=$3 lane=$4
N=$HOME/.cache/ai-runs/night A=$HOME/.local/state/lonca/approvals L=$HOME/lonca/bin
LOG=$HOME/.local/state/lonca/merge.log   # the audit trail: kept, unlike the run folders in ~/.cache
no() { echo "$me: refused PR #$pr: $*" >&2; echo "$(date -Iseconds) refused $repo #$pr: $*" >> "$LOG" 2>/dev/null || true; exit 1; }
GH=$(PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v "lonca/shims" | paste -sd: -) command -v gh)   # the real gh, not the shim

project=$("$L/lonca-project" "$repo") || { echo "$me: no Lonca project marker for $repo" >&2; exit 1; }
proj=${project%%	*}
mkdir -p "$N" "${LOG%/*}"; i=0   # one merge at a time on this machine (the night cap is counted inside the lock)
until mkdir "$N/.merge.lock" 2>/dev/null; do
  i=$((i + 1)); [ $i -gt 300 ] && { echo "$me: another merge has held $N/.merge.lock for 5 min (remove it if stale)" >&2; exit 1; }
  sleep 1
done
trap 'rmdir "$N/.merge.lock" 2>/dev/null' EXIT INT TERM

info=$(cd "$repo" && "$GH" pr view "$pr" --json state,isDraft,mergeable,title,body,statusCheckRollup,headRefOid,baseRefName,headRefName 2>/dev/null) || no "cannot read the PR"
head=$(printf '%s' "$info" | python3 -I -c 'import json,sys;print(json.load(sys.stdin)["headRefOid"])')
base=$(printf '%s' "$info" | python3 -I -c 'import json,sys;print(json.load(sys.stdin)["baseRefName"])')
nwo=$(cd "$repo" && "$GH" repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) || no "cannot read the repo name"
key=$(printf '%s' "$nwo" | tr '/' '_')_$pr short=${head%"${head#???????}"}

# Risk tier (from the PR's diff; the lead may only raise it) and the project's settings
t=$("$L/merge-tier" "$repo" "$pr" "$run" "$lane" 2>&1) || no "$t"
tier=${t%%	*} why=${t#*	}
cfg=$("$L/merge-tier" --config "$repo" "$base" 2>/dev/null) || cfg='{}'
setting() { printf '%s' "$cfg" | python3 -I -c 'import json,sys; v=json.load(sys.stdin).get(sys.argv[1]); print("" if v is None else str(v).lower())' "$1"; }
level=$(setting auto_merge); [ -n "$level" ] || level=$("$L/lonca-config" auto_merge off)
wait_ci=$(setting wait_for_ci)

# Approval
how=ask
if [ -n "$code" ]; then
  [ -f "$A/$key" ] || no "no approval request for $nwo#$pr: run $me without --code first"
  set -- $(cat "$A/$key")   # <code> <head> <epoch>
  [ "$1" = "$code" ] || no "code '$code' does not match the one asked for $nwo#$pr"
  [ "$2" = "$head" ] || no "the PR changed since the owner approved it (${2%"${2#???????}"} -> $short): ask again"
  [ $(( $(date +%s) - $3 )) -lt 3600 ] || no "the code is older than 1 h: ask again"
  how=code
elif LEVEL=$level TIER=$tier python3 -I -c 'import os,sys; r={"low":0,"medium":1,"high":2,"all":2}; sys.exit(0 if r.get(os.environ["LEVEL"],-1) >= r[os.environ["TIER"]] else 1)'; then
  how=auto
elif [ -n "$proj" ] && [ -f "$N/$proj.json" ]; then
  python3 -I - "$N/$proj.json" "$LOG" "$proj" <<'PY' && how=night || no "night mode for $proj is past its end time or its cap"
import datetime, json, os, sys
f, log, p = sys.argv[1:]
n = json.load(open(f))
assert datetime.datetime.now().astimezone() < datetime.datetime.fromisoformat(n["until"])
mx = n.get("max_merges", "unlimited")
if mx != "unlimited":
    since = os.path.getmtime(f)
    done = sum(1 for l in open(log) if f" merged [night:{p}] " in l
               and datetime.datetime.fromisoformat(l.split()[0]).timestamp() >= since) if os.path.exists(log) else 0
    assert done < int(mx)
PY
fi

# Checks
err=$(printf '%s' "$info" | NOWAIT=$([ "$wait_ci" = false ] && echo 1 || echo 0) python3 -I -c '
import json,os,sys; p=json.load(sys.stdin); nowait=os.environ["NOWAIT"]=="1"
assert p["state"]=="OPEN" and not p["isDraft"], "not open, or draft"
assert p["mergeable"]=="MERGEABLE", "not mergeable: "+p["mergeable"]
def running(c): return c.get("status") not in (None,"COMPLETED") or c.get("state") in ("PENDING","EXPECTED")
bad=[c.get("name") or c.get("context") for c in p["statusCheckRollup"]
     if (c.get("conclusion") or c.get("state")) not in ("SUCCESS","SKIPPED","NEUTRAL") and not (nowait and running(c))]
assert p["statusCheckRollup"] or nowait, "no CI checks on the PR (set wait_for_ci = false for a repo without CI)"
assert not bad, "checks not green: "+str(bad)
' 2>&1) || no "$(printf '%s' "$err" | tail -1)"
evd=$("$L/merge-evidence" "$run" "$lane" "$head" "$tier" 2>&1) || no "$(printf '%s' "$evd" | tail -1)"
printf '%s' "$info" | python3 -I -c 'import json,sys;p=json.load(sys.stdin);print(p["title"]);print(p["body"])' | "$L/ai-trace-check" 2>/dev/null || no "PR title/body has AI traces"

if [ $dry = 1 ]; then echo "$me: dry run OK for $nwo#$pr -> $base, tier $tier ($why), approval: $how"; exit 0; fi
if [ "$how" = ask ]; then
  mkdir -p "$A"
  if [ -f "$A/.batch" ] && [ $(( $(date +%s) - $(date -r "$A/.batch" +%s) )) -lt 300 ]; then c=$(cat "$A/.batch")
  else c=$(python3 -I -c 'import secrets; print("".join(secrets.choice("abcdefghjkmnpqrstuvwxyz23456789") for _ in range(3)))'); echo "$c" > "$A/.batch"; fi
  echo "$c $head $(date +%s)" > "$A/$key"
  echo "$me: checks passed; ask the owner. Show: $nwo#$pr -> $base, head $short, tier $tier ($why), your opinion$( [ "$tier" = high ] && echo ' and the risks')."
  echo "They approve by writing:  evet $c     then run:  $me --code $c $repo $pr $run $lane   (this head only, 1 h)"
  exit 3
fi
method=$(git -C "$repo" config lonca.mergeMethod || true)
[ -n "$method" ] || method=$(cd "$repo" && "$GH" repo view --json mergeCommitAllowed,squashMergeAllowed,rebaseMergeAllowed \
  -q 'if .mergeCommitAllowed then "merge" elif .squashMergeAllowed then "squash" else "rebase" end' 2>/dev/null) || method=merge
(cd "$repo" && "$GH" pr merge "$pr" "--$method" --match-head-commit "$head") || no "gh merge ($method) failed"
[ "$how" = code ] && rm -f "$A/$key"
tag=$how; [ "$how" = night ] && tag="night:$proj"
echo "$(date -Iseconds) merged [$tag] $repo #$pr -> $base (lane $lane, tier $tier)" >> "$LOG"
"$L/kanzo-sync" >/dev/null 2>&1 || true   # its card -> done now, not at the next timer run
# the lane that built it is done: close its terminal, remove its worktree and local branch now (not at night)
branch=$(printf '%s' "$info" | python3 -I -c 'import json,sys;print(json.load(sys.stdin)["headRefName"])')
git -C "$repo" worktree list --porcelain | awk -v b="refs/heads/$branch" '/^worktree /{w=substr($0,10)} $0=="branch "b{print w}' |
while read -r wt; do
  case $wt in "$HOME"/.herdr/worktrees/*) ;; *) continue ;; esac   # only Lonca's lane worktrees
  env -u CLAUDECODE hc ls --json 2>/dev/null | python3 -I -c 'import json,sys
for t in json.load(sys.stdin).get("terminals", []):
    if t.get("cwd", "").startswith(sys.argv[1]): print(t["address"])' "$wt" | while read -r t; do env -u CLAUDECODE hc kill "$t" >/dev/null 2>&1; done
  sleep 2
  if git -C "$repo" worktree remove "$wt" 2>/dev/null; then git -C "$repo" branch -D "$branch" >/dev/null 2>&1; echo "$me: closed the lane and removed $wt"
    echo "$(date -Iseconds) removed worktree $wt + branch $branch after merging $repo #$pr" >> "$LOG"
  else echo "$me: left $wt (uncommitted changes); ai-cleanup takes it once clean"; fi
done
echo "$me: merged $nwo#$pr into $base ($method, tier $tier, $how)"
