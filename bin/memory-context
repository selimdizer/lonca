#!/usr/bin/env python3
"""SessionStart: print the marked project's memory index for the hook's cwd."""
import json
import os
import subprocess
import sys
from pathlib import Path

from claude_session import duplicate

if os.environ.get("LONCA") == "0":
    sys.exit(0)
try:
    event = json.load(sys.stdin)
except ValueError:
    event = {}
if duplicate("memory-context", event):
    sys.exit(0)
home = Path.home()
project = subprocess.run([home / "lonca/bin/lonca-project", event.get("cwd") or os.getcwd()],
                         capture_output=True, text=True)
if project.returncode == 0:
    group, root = project.stdout.rstrip("\n").split("\t")
    if group not in ("owner", "setup", "personal"):
        index = home / "ai-memory" / group / "INDEX.md"
        if index.is_file():
            print(f"# Project memory index ({index}; notes are files next to it)")
            print(index.read_text(), end="")
        else:
            print(f'# Project memory: {root} (project "{group}") has no memory group yet. '
                  f'Save its notes in {index.parent}/ and index them in {index} (see ~/ai-memory/README.md).')
