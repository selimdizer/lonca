#!/bin/sh
# Start one lane as an interactive agent in its own git worktree, as a herdr-core (hc) terminal: visible in the Herdr app.
#   lane <repo-dir> <branch> <agent> <brief-file> <result-file> [base-branch]
#   lane --read <repo-dir> <name> omp:<provider/model> <brief-file> <result-file>
#     read-only lane: no worktree, runs in <repo-dir> with read/grep/glob (omp still loads its MCP servers); its answer is the report
#   lane --browser <repo-dir> <branch> claude:<role> <brief-file> <result-file> [base-branch]
#     a Claude lane with a browser: chrome-devtools MCP from ~/lonca-local/mcp/chrome-devtools.json (Codex/omp: not needed now)
#   agent: claude:<role> (implementer|reviewer|verifier|security-auditor) | codex:<model>[:<effort>] (default xhigh) | omp:<provider/model>
#          | opencode:<provider/model> | copilot:<model> | agy:<model> (Antigravity) | pi:<provider/model> | grok:<model>
#          (Crush and Amp take no starting prompt: not lane agents)
# The agent writes its final report to <result-file>; the lead waits for that file, not for herdr state.
# The branch starts from a fresh origin/<base> (default: the remote's default branch); an existing branch is reused.
# Needs herdr-core (hc): no silent headless fallback.
set -eu
# Drop the calling agent's session variables: a lane is its own session (else Claude skips its transcript),
# and an hc core started from here must not carry them (they include the caller's messaging token).
for v in $(env | cut -d= -f1 | grep -E '^(CLAUDECODE|CLAUDE_[A-Z_]*|CODEX_COMPANION_[A-Z_]*)$'); do unset "$v"; done
# Agents run with full permissions; ~/lonca/shims (gh, git, docker, pkill, killall guards) go first in PATH.
export PATH="$HOME/lonca/shims:$HOME/lonca-local/shims:$PATH"   # Lonca's guards, then your own shims
ro=0 browser=0; case ${1:-} in --read) ro=1; shift ;; --browser) browser=1; shift ;; esac
case ${1:-} in -h|--help|"") sed -n '2,/^set -eu/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;; esac
[ $# -eq 5 ] || [ $# -eq 6 ] || { echo "usage: lane [--read|--browser] <repo-dir> <branch|name> <agent> <brief-file> <result-file> [base-branch]   (lane --help)" >&2; exit 2; }
repo=$1 branch=$2 agent=$3 brief=$(realpath "$4") result=$5 base=${6:-}
if [ $browser = 1 ]; then
  case $agent in claude:*) ;; *) echo "lane --browser: Claude lanes only (Codex/omp: not needed now)" >&2; exit 2 ;; esac
  [ -f "$HOME/lonca-local/mcp/chrome-devtools.json" ] || { echo "lane --browser: no $HOME/lonca-local/mcp/chrome-devtools.json" >&2; exit 1; }
fi
repo=$(realpath "$repo")
# Read lanes only read files (also temp copies outside Git): no Git guards to check.
if [ $ro = 0 ] && ! "$HOME/lonca/bin/lonca" status --lane --agent "${agent%%:*}" "$repo" >/dev/null; then
  root=$("$HOME/lonca/bin/lonca-project" "$repo" || true)
  root=${root#*	}
  python3 -I -c 'import shlex,sys; print("lane: ask your lead to run lonca init " + shlex.quote(sys.argv[1]), file=sys.stderr)' "${root:-$repo}"
  exit 1
fi
project=$("$HOME/lonca/bin/lonca-project" "$repo") || { echo "lane: no Lonca project marker for $repo" >&2; exit 1; }
proot=${project#*	}
# /tmp is RAM (tmpfs): agent temp files, Go builds and Node caches go to disk
export TMPDIR="$("$HOME/lonca/bin/lonca-config" tmpdir "$HOME/.cache/lonca/tmp")"; mkdir -p "$TMPDIR"
command -v hc >/dev/null 2>&1 && hc server status >/dev/null 2>&1 || { echo "lane: herdr-core (hc) is not running; not starting a lane" >&2; exit 1; }
mkdir -p "$(dirname "$result")"; result="$(cd "$(dirname "$result")" && pwd -P)/$(basename "$result")"
# deja recall limited to this project's own sessions (deja-scope); every lane agent passes it to its deja MCP server
DEJA_POLICY_FILE=$("$HOME/lonca/bin/deja-scope" "$repo") || { echo "lane: could not scope deja to this project; not starting" >&2; exit 1; }
prompt="Read ~/lonca/AGENTS.md for the project rules. Read the brief at $brief and do the lane it describes. When you are done, or stopped, write your final report (at most 30 lines, with a Not verified section, ending with a Lessons section: facts a future session in this project would need, such as a gotcha, a command that works or a decision you learned, or none) to $result and end. Do not write to ~/ai-memory yourself; the lead saves your lessons. Something the brief does not settle, or that may have been decided before: search past sessions first (deja search \"<topic>\", or the deja MCP tool) and the project memory; ask only if they don't answer it."
# Project skills live in the project root (the folder with .lonca.toml, not a team repo): point the lane at them
psk="$proot/.claude/skills"
[ -n "$proot" ] && [ "$proot" != "$(realpath "$repo")" ] && [ -d "$psk" ] && prompt="$prompt This project's own skills (follow the one that fits, e.g. its verify skill before you report done): $(ls -d "$psk"/*/SKILL.md 2>/dev/null | tr '\n' ' ')"
# The brief's "Card:" line (Kanzo task, e.g. shop#44): the lane keeps that card current itself
card=$(sed -n 's/^Card:[[:space:]]*\([A-Za-z0-9_-]*#[0-9][0-9]*\).*/\1/p' "$brief" | head -1)
[ -n "$card" ] && prompt="$prompt Your Kanzo card is $card (kanzo MCP tools; in Claude load them with ToolSearch first): set it to doing now, add a short comment on what you did at each milestone, set its url to your PR when you open it, and move it to review when you finish or get stuck."
prompt="$prompt Stay inside this project: no other project's Kanzo cards (never project \"all\" or another slug) and no other project's files or past sessions."

# Quote a TOML string as one argument of the command passed to the lane shell.
override() {
  python3 -I -c 'import json,shlex,sys; print(shlex.quote(sys.argv[1] + "=" + json.dumps(sys.argv[2], ensure_ascii=False)))' "$1" "$2"
}
case $agent in
  claude:*) role=$("$HOME/lonca/bin/lonca-project" --claude-agent "${agent#claude:}" "$repo")
            cmd="claude --agent $role --permission-mode bypassPermissions"
            [ $browser = 1 ] && cmd="$cmd"' --mcp-config "$HOME/lonca-local/mcp/chrome-devtools.json"' ;;
  # codex: full permissions; its own rules don't apply in that mode, the shims below do
  # interactive (not exec) so the Herdr app shows its status; --no-daemon is required under hc
  # --disable apps: the ChatGPT GitHub connector may act as a different GitHub account; lanes use gh
  codex:*)  m=${agent#codex:}; e=${m#*:}; [ "$e" = "$m" ] && e=xhigh; m=${m%%:*}   # codex:<model>[:<effort>], default xhigh (routing.md)
            cmd="codex --no-daemon --dangerously-bypass-approvals-and-sandbox --disable apps -m $m -c model_reasoning_effort=$e"
            # An external worktree may not load the main checkout's personal MCP tables.
            for server in kanzo deja; do
              cmd="$cmd -c $(override "mcp_servers.$server.command" "$server") -c 'mcp_servers.$server.args=[\"mcp\"]'"
            done
            # Codex starts MCP servers with a minimal environment: hand deja its policy file explicitly
            cmd="$cmd -c $(override mcp_servers.deja.env.DEJA_POLICY_FILE "$DEJA_POLICY_FILE")"
            # Codex asks folder trust for the worktree's main repo; trust it once (else the lane waits at a prompt)
            main=$(realpath "$repo")
            mkdir -p "$HOME/.codex"
            grep -qF "[projects.\"$main\"]" ~/.codex/config.toml 2>/dev/null ||
              printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$main" >> ~/.codex/config.toml ;;
  # Copilot lanes (client work limited to Copilot): helpers stay on Copilot too, so no code goes to DeepSeek/GLM
  omp:github-copilot/*) cmd="omp --model ${agent#omp:} --smol github-copilot/claude-sonnet-5.5 --slow github-copilot/claude-opus-5.5" ;;
  omp:*)    cmd="omp --model ${agent#omp:}" ;;
  copilot:*) cmd="copilot --model ${agent#copilot:} --yolo -i" ;;            # -i: runs the prompt, stays interactive
  pi:*)      cmd="pi --model ${agent#pi:}" ;;                                # pi has no approvals to bypass
  agy:*)     cmd="agy --model ${agent#agy:} --dangerously-skip-permissions -i" ;;   # Antigravity CLI; worktree trust below
  grok:*)    cmd="grok -m ${agent#grok:} --always-approve" ;;              # the prompt is the positional argument
  opencode:*) cmd="opencode mini --standalone --agent lonca-lane --model ${agent#opencode:} --prompt" ;;   # standalone: its tools run in this terminal (shims, TMPDIR, tagged messages); permissions: the lonca-lane agent
  *) echo "unknown agent: $agent" >&2; exit 2 ;;
esac
quoted=$(printf '%s' "$prompt" | sed "s/'/'\\\\''/g")

rkey="$(basename "$(dirname "$repo")")-$(basename "$repo")"
if [ $ro = 1 ]; then
  case $agent in omp:*) ;; *) echo "lane --read: omp agents only (Claude read-only roles are subagents)" >&2; exit 2 ;; esac
  wt=$(realpath "$repo") base=-
  prompt="Read the brief at $brief and answer it from the code in this folder. Your final answer is saved as the report: at most 30 lines, with a Not verified section, ending with a Lessons section (facts a future session in this project would need, or none)."
  quoted=$(printf '%s' "$prompt" | sed "s/'/'\\\\''/g")
else
# Worktrees live under ~/.herdr/worktrees: Claude already trusts that folder (no trust prompt in lanes).
# <parent>-<repo> keeps same-named repos of different projects apart
wt="$HOME/.herdr/worktrees/$rkey/$(printf '%s' "$branch" | tr '/' '-')"
mkdir -p "$(dirname "$wt")"
git -C "$repo" fetch -q origin
[ -n "$base" ] || base=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD | sed 's|^origin/||')
[ -n "$base" ] || base=main
if [ -d "$wt" ] && git -C "$wt" rev-parse -q --verify HEAD >/dev/null 2>&1; then
  [ "$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)" = "$repo/.git" ] &&
    [ "$(git -C "$wt" branch --show-current)" = "$branch" ] ||
    { echo "lane: existing worktree does not match $repo and $branch" >&2; exit 1; }
  :                                                         # worktree of an earlier run of this lane: reuse it
elif git -C "$repo" show-ref -q --verify "refs/heads/$branch"; then
  git -C "$repo" worktree add -q "$wt" "$branch"            # rerun of an existing lane branch
else
  git -C "$repo" worktree add -q "$wt" -b "$branch" "origin/$base"
fi
fi

  # hc names are unique among live terminals: repo prefix + branch, then a short hash if it had to be cut
# prefix: the project's name (lonca-project above), not the folder: a read lane may run in a temp copy named src
name=$(printf '%s-%s' "$(printf '%s' "${project%%	*}" | cut -c1-8)" "$branch" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_-' '-')
[ ${#name} -gt 32 ] && name="$(printf '%s' "$name" | cut -c1-25)-$(printf '%s' "$rkey/$branch" | { sha1sum 2>/dev/null || shasum; } | cut -c1-6)"
# its own temp folder, so a cleanup inside it can't reach another lane's files (ai-cleanup removes it once idle);
# Claude's and Codex's own settings may pin TMPDIR for their tools, so they get it through their override flags too
ltmp=$(mktemp -d "$TMPDIR/lane-$name.XXXXXXXX")
case $agent in
  omp:*) cmd="$cmd"' --extension "$HOME/lonca/config/omp-lane"' ;;
  opencode:*) export OPENCODE_CONFIG_DIR="$HOME/lonca/config/opencode" ;;
  claude:*) settings=$(python3 -I -c 'import json,shlex,sys; print(shlex.quote(json.dumps({"env":{"TMPDIR":sys.argv[1]},"attribution":{"commit":"","pr":""},"includeCoAuthoredBy":False})))' "$ltmp")
            cmd="$cmd --settings $settings" ;;
  codex:*)  cmd="$cmd -c $(override shell_environment_policy.set.TMPDIR "$ltmp")"
            cmd="$cmd -c $(override shell_environment_policy.set.GIT_CONFIG_COUNT 1)"
            cmd="$cmd -c $(override shell_environment_policy.set.GIT_CONFIG_KEY_0 core.hooksPath)"
            cmd="$cmd -c $(override shell_environment_policy.set.GIT_CONFIG_VALUE_0 "$HOME/lonca/git-hooks")" ;;
esac
  # Started from a lead inside the Herdr app: open the lane as its own tab in the lead's space
  space=$( [ -n "${HC_TERMINAL_ID:-}" ] && hc get "$HC_TERMINAL_ID" --json 2>/dev/null | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("labels",{}).get("herdr.space",""))' 2>/dev/null || true)
  # Started by a lead in an hc terminal: the lane reports DONE and asks questions there; the lead answers with hc send
  if [ $ro = 1 ]; then
    # print mode: the answer streams into the tab and the report file; DONE goes to the lead from here
    run="echo 'lane $name: omp ${agent#omp:}, read-only, no screen while it works: the report appears here when it finishes.'; { $cmd -p --no-session --tools read,grep,glob '$quoted'; echo \$? > '$result.rc'; } | tee '$result.part' && [ \"\$(cat '$result.rc')\" = 0 ] && mv '$result.part' '$result'; rm -f '$result.rc'"
    [ -n "${HC_TERMINAL_ID:-}" ] && run="$run && hc send $HC_TERMINAL_ID \"DONE: \$(grep -m1 . '$result' | cut -c1-120) — $result\""
  elif [ -n "${HC_TERMINAL_ID:-}" ]; then
    prompt="$prompt Talk to your lead (hc terminal $HC_TERMINAL_ID; hc adds your name itself) only in two cases: a question the brief does not answer -> hc send $HC_TERMINAL_ID 'QUESTION: <question>' and wait, the answer is typed into your input; after writing the report -> hc send $HC_TERMINAL_ID 'DONE: <one plain line for the owner: the outcome, e.g. PR #N opened, tests pass / 3 findings, 1 high / blocked on X> — $result'. No progress or status messages: those go in the report."
    quoted=$(printf '%s' "$prompt" | sed "s/'/'\\\\''/g")
  fi
  [ $ro = 1 ] || run="exec $cmd '$quoted'"
  set -- --label "repo=$(basename "$(realpath "$repo")")"
  [ -n "$space" ] && set -- "$@" --label "herdr.space=$space" --label "herdr.tab=lane-$name"
  [ $ro = 1 ] && set -- "$@" --no-notify   # it sends DONE itself and exits right after: no second "exited" note
  # Folder trust, each CLI's documented way, so no lane waits at a trust prompt:
  case $agent in
    claude:*)  # Claude keeps trust per git repo root and a worktree inherits its main checkout's: trust that once
      python3 -I - "$(realpath "$repo")" <<'PY'
import json, os, sys, tempfile
f = os.path.expanduser("~/.claude.json"); root = sys.argv[1]
d = json.load(open(f))
p = d.setdefault("projects", {}).setdefault(root, {})
if not p.get("hasTrustDialogAccepted"):
    p["hasTrustDialogAccepted"] = True
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(f)); os.write(fd, json.dumps(d, indent=2).encode()); os.close(fd)
    os.chmod(tmp, os.stat(f).st_mode & 0o777); os.replace(tmp, f)
PY
      ;;
    agy:*)     # Antigravity trusts exact paths only: this worktree, for this session
      cmd="${cmd% -i} --settings '{\"trustedWorkspaces\":[\"$wt\"]}' -i"; run="exec $cmd '$quoted'" ;;
    grok:*)    # Grok keeps folder trust in ~/.grok/trusted_folders.toml, per main repo (its worktrees inherit it)
      main=$(realpath "$repo"); f="$HOME/.grok/trusted_folders.toml"
      grep -qF "[folders.\"$main\"]" "$f" 2>/dev/null || { mkdir -p "${f%/*}"; printf '[folders."%s"]\ntrusted = true\ndecided_at = %s\n' "$main" "$(date +%s)" >> "$f"; } ;;
  esac   # Copilot: install.sh lists ~/.herdr/worktrees in trustedFolders, which covers every worktree below it
  # Record ownership before the terminal starts (a failed launch is still recoverable).
  python3 "$HOME/lonca/bin/lane-record" "$name" "$wt" "${HC_TERMINAL_ID:-}" "$agent" "$base" "$result" "$card" \
    "$( [ $ro = 1 ] || printf '%s' "$branch")" "$repo" "$proot" "$ltmp"
  set -- "$@" --label "lonca.run=$ltmp"
  # --outlive-parent: a lane keeps running if the lead's session ends; its exit is noted in the lead's input
  # Expand the child shell's PATH and positional argument inside hc.
  # The lane runs in its own memory-capped scope when one can be made where it runs: when memory runs out,
  # only this lane is killed, not every terminal in Herdr's unit (lonca#336). $c splits into its words on purpose.
  # shellcheck disable=SC2016
  hc run --bg --outlive-parent --name "$name" --cwd "$wt" "$@" \
    -- env ${OPENCODE_CONFIG_DIR:+"OPENCODE_CONFIG_DIR=$OPENCODE_CONFIG_DIR"} "LONCA_LANE=$name" \
       GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath "GIT_CONFIG_VALUE_0=$HOME/lonca/git-hooks" \
       "TMPDIR=$ltmp" "DEJA_POLICY_FILE=$DEJA_POLICY_FILE" ${XDG_RUNTIME_DIR:+"XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"} sh -c 'export PATH="$HOME/lonca/shims:$HOME/lonca-local/shims:$PATH"
      c="systemd-run --user --scope --quiet --expand-environment=no -p MemoryMax=16G -p MemorySwapMax=4G -p OOMPolicy=continue --"; $c true 2>/dev/null || c=
      exec $c sh -c "$1"' sh "$run" >/dev/null   # hc passes no env: set it here
  [ -n "$card" ] && { "$HOME/lonca/bin/kanzo-sync" set "$card" doing >/dev/null 2>&1 || echo "lane: could not set $card to doing" >&2; }
  [ $ro = 1 ] && { echo "lane: read-only $name in $wt (hc terminal $name) -> $result"; exit 0; }
  echo "lane: $branch in $wt from origin/$base (hc terminal $name) -> $result"
