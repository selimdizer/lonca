#!/bin/sh
# Agents may push their own branches and open PRs; nobody pushes main/master
# except the owner on purpose:  ALLOW_MAIN_PUSH=1 git push ...
[ "$ALLOW_MAIN_PUSH" = "1" ] && exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: push to ${remote_ref#refs/heads/} is blocked. Push a branch and open a PR; the owner merges." >&2
      exit 1 ;;
  esac
done
exit 0
