#!/bin/sh
# No AI attribution in commit messages of repos that are pushed anywhere (see bin/ai-trace-check);
# local-only repos (no remote, e.g. ~/ai-memory) are skipped. Then the repo's own commit-msg hook, if any.
if [ "${LONCA:-}" != 0 ] && [ -n "$(git remote)" ]; then "$HOME/lonca/bin/ai-trace-check" < "$1" || exit 1; fi
own="$(git rev-parse --git-common-dir)/hooks/commit-msg"
[ -x "$own" ] && [ "$(readlink -f "$own")" != "$(readlink -f "$0")" ] && exec "$own" "$@"
exit 0
