#!/bin/sh
# Command guard for agents started with full permissions (Codex bypass mode skips its own rules).
# Symlinked as gh, git, pkill, killall, lonca, docker in ~/lonca/shims; agent launches put that dir first in PATH.
# Same hard limits as ~/lonca/AGENTS.md. shortcut: matches argv text, not a parser; the pre-push hook backs up git.
name=$(basename "$0")
L=$(dirname "$(dirname "$(readlink -f "$0")")")   # the Lonca checkout this shim belongs to
args=" $* "
deny() { echo "lonca guard: blocked '$name$args'— $1. Stop and report to the owner." >&2; exit 126; }

# run the real binary: PATH without this shims dir
here=$(dirname "$(readlink -f "$0")")
real_path=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx "$here" | grep -vx "$(dirname "$0")" | paste -sd: -)

# The git rules, on one argv. An alias already in git config is looked up with the real git and its expansion checked
# the same way. Git ignores an alias named like a built-in (unless the built-in is deprecated), so those never expand.
# shortcut: quotes and backslashes are dropped and the text split on spaces, so "a b" reads as two words (stricter, not
# looser, for flags); a real parser if a quoted argument must stay whole.
expansions=0
git_check() {
  s=" $* " sub= skip= n=0   # n: global options before the subcommand
  # Hook skips anywhere after the subcommand: --no-verify (a unique prefix on commit and push; exact on
  # merge and pull, which also have --no-verify-signatures), and -n alone or in a cluster (-an) on commit.
  for a do
    if [ -n "$skip" ]; then skip=; [ -n "$sub" ] || n=$((n + 1)); continue; fi
    if [ -z "$sub" ]; then
      case $a in -C|-c|--git-dir|--work-tree|--namespace|--config-env|--attr-source) skip=1 n=$((n + 1)) ;; -*) n=$((n + 1)) ;; *) sub=$a ;; esac
      continue
    fi
    case $sub:$a in
      *:--) break ;;
      commit:--no-veri*|push:--no-veri*|merge:--no-verify|pull:--no-verify) deny "don't skip git hooks" ;;
      commit:-[!-]*)
        o=${a#-}
        while [ -n "$o" ]; do
          c=${o%"${o#?}"}; o=${o#?}
          case $c in
            n) deny "don't skip git hooks" ;;
            [mCcFt]) [ -z "$o" ] && skip=1; break ;;   # takes a value: the rest, or the next argument
            [Su]) break ;;                              # optional value, only inline
          esac
        done ;;
    esac
  done
  case $(printf '%s' "$s" | tr '[:upper:]' '[:lower:]') in
    *hookspath*|*include*".path"*|*alias.*|*" config "*)
      python3 -I "$L/shims/hooks-config.py" "$@" || deny "don't change git hooks" ;;
  esac
  case $s in
    *" push "*" --force"*|*" push "*" -f "*|*" push --force"*|*" push -f "*|*" push "*" +"*) deny "no force-push" ;;
    *" push "*" --delete"*|*" push "*" -d "*|*" push "*" :"*) deny "no branch deletion" ;;
    *" push "*" main "*|*" push "*":main "*|*" push "*" master "*|*" push "*":master "*) deny "push a branch and open a PR; the default branch is the owner's" ;;
    *"core.hooksPath="*|*"core.hookspath="*) deny "don't bypass git hooks" ;;
    *" push "*" --no-verify"*) deny "don't skip the pre-push hook" ;;
    *" reset --hard"*|*" reset "*" --hard"*) deny "no reset --hard" ;;
    *" clean "*) deny "no git clean" ;;
    *" branch -D "*|*" branch "*" -D "*) deny "no branch deletion" ;;
  esac
  [ -n "$sub" ] || return 0
  ! git_list builtins "$sub" || git_list deprecated "$sub" || return 0
  for k in "alias.$sub" "alias.$sub.command"; do   # both spellings git reads ([alias "x"] command = ...)
    exp=$(alias_of "$n" "$k" "$@")
    [ -z "$exp" ] || (alias_check "$n" "$exp" "$@") || exit 126   # a subshell: this loop's state survives
  done
}
alias_check() {   # <global-option count> <alias text> <argv>: the git rules on the argv the alias expands to
  n=$1 exp=$(printf '%s' "$2" | tr -d "\"'\\\\") i=0; shift 2
  expansions=$((expansions + 1)); [ $expansions -le 8 ] || deny "git aliases nest too deep"
  for a do   # rebuild the argv: the alias's words in place of the subcommand
    shift; i=$((i + 1))
    if [ $i -eq $((n + 1)) ]; then set -- "$@" ${exp#!}; else set -- "$@" "$a"; fi
  done
  case $exp in !*) ;; *) git_check "$@"; return ;; esac
  while [ $# -gt 0 ]; do   # a shell alias: every git command in its text, as if typed with the arguments after it
    case $1 in
      *git) shift; git_check "$@" ;;
      *git-?*) a=${1##*git-}; shift; git_check "$a" "$@" ;;   # git puts its exec path (git-commit) on a ! alias's PATH
      *) shift ;;
    esac
  done
}
git_list() { env PATH="$real_path" git --list-cmds="$1" 2>/dev/null | grep -qxF -- "$2"; }   # <group> <command>
alias_of() {   # <global-option count> <config key> <argv>: the alias's text, read with the real git and those options
  k=$1 key=$2 j=0; shift 2
  for a do shift; j=$((j + 1)); [ $j -gt "$k" ] || set -- "$@" "$a"; done
  env PATH="$real_path" git "$@" config --get "$key" 2>/dev/null
}

case $name in
  pkill|killall) deny "stop only processes you started, by PID" ;;
  docker)
    # In a lane (LONCA_LANE carries its name; 1 = a lane started before names), its containers carry the lane's label
    # so closing the lane removes them. shortcut: knows the global flags that take a value, not every plugin's.
    case ${LONCA_LANE:-1} in 1) ;; *)
      sub= skip= done=
      for a do
        shift; set -- "$@" "$a"   # rotate: the argument list is rebuilt with the label inserted after run/create
        if [ -n "$done" ]; then continue; elif [ -n "$skip" ]; then skip=; continue; fi
        case $sub:$a in
          :--config|:-c|:--context|:-H|:--host|:-l|:--log-level|:--tlscacert|:--tlscert|:--tlskey) skip=1 ;;
          :-*) ;;
          :container) sub=container ;;
          :run|:create|container:run|container:create) set -- "$@" --label "lonca.lane=$LONCA_LANE"; done=1 ;;
          :compose) export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-lonca-lane-$LONCA_LANE}"; done=1 ;;   # reserved: cleanup takes only these
          *) done=1 ;;
        esac
      done ;;
    esac ;;
  lonca)
    case ${1:-} in init|remove|migrate) deny "manage project protections from the lead or owner shell" ;; esac
    case ${1:-}:${2:-} in questions:answer|questions:drop) deny "only the lead records the owner's answers" ;; esac
    exec "$L/bin/lonca" "$@" ;;
  gh)
    case $args in
      " pr merge "*|*" api "*merge*) deny "merge only with merge-pr (checks first)" ;;
    esac
    "$L/bin/ai-trace-gh" "$@" || exit 126 ;;
  git)
    if [ -n "${LONCA_LANE:-}" ] && { [ "${GIT_CONFIG_COUNT:-}" != 1 ] ||
        [ "${GIT_CONFIG_KEY_0:-}" != core.hooksPath ] || [ "${GIT_CONFIG_VALUE_0:-}" != "$HOME/lonca/git-hooks" ]; }; then
      deny "lane Git hook environment changed or missing; restart the lane"
    fi
    # GIT_CONFIG_PARAMETERS (git -c) wins over the lane triple and the repo's hooksPath.
    case $(printf '%s' "${GIT_CONFIG_PARAMETERS:-}" | tr '[:upper:]' '[:lower:]') in
      *hookspath*|*include*|*alias.*) deny "don't bypass git hooks" ;;   # an alias can hide a hook skip
    esac
    set -f   # alias words are split below, never globbed
    git_check "$@" ;;
esac

exec env PATH="$real_path" "$name" "$@"
